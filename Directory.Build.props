<Project>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.0.0</Version>
    <!--
      AssemblyVersion is pinned to <major>.0.0.0 so every 1.x build is binary-identical in identity
      and a patch or minor upgrade is a drop-in replacement, with no assembly-version mismatch for a
      consumer that compiled against an earlier 1.x. FileVersion and InformationalVersion still carry
      the full version (and, via SourceLink, the commit), so a specific build stays identifiable.
    -->
    <AssemblyVersion>$(Version.Split('.')[0]).0.0.0</AssemblyVersion>
    <RepositoryUrl>https://github.com/bfriesen/RandomSkunk.StructuredLogging</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/bfriesen/RandomSkunk.StructuredLogging</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/bfriesen/RandomSkunk.StructuredLogging/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!--
    ContinuousIntegrationBuild makes SourceLink/Deterministic builds map source paths to the
    repo's URL instead of the local machine's absolute paths; only enabled in CI (see
    .github/workflows) so local `dotnet pack` output stays debuggable from the local checkout.
  -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
