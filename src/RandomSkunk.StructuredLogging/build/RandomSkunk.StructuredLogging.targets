<Project>

  <!--
    Installs this package's coding-agent guidance files into the consuming project, so
    Claude Code, Cursor, GitHub Copilot, and Codex (or any other AGENTS.md-convention tool) all
    pick up guidance on using RandomSkunk.StructuredLogging's API instead of
    Microsoft.Extensions.Logging's Log*/LogInformation/etc. extension methods. Each install below
    has its own opt-out property; set it to true in the consuming project to skip that one tool.
  -->

  <!-- Claude Code: drop-in skill file, auto-discovered, never touches other files. -->
  <PropertyGroup>
    <_RandomSkunkStructuredLoggingSkillSource>$(MSBuildThisFileDirectory)../skillfiles/randomskunk-structuredlogging/SKILL.md</_RandomSkunkStructuredLoggingSkillSource>
    <_RandomSkunkStructuredLoggingSkillDestination>$(MSBuildProjectDirectory)/.claude/skills/randomskunk-structuredlogging/SKILL.md</_RandomSkunkStructuredLoggingSkillDestination>
  </PropertyGroup>

  <Target Name="InstallRandomSkunkStructuredLoggingSkill"
          BeforeTargets="Build"
          AfterTargets="Restore"
          Condition="'$(RandomSkunkStructuredLoggingSkipSkillInstall)' != 'true' and Exists('$(_RandomSkunkStructuredLoggingSkillSource)')">
    <Copy
      SourceFiles="$(_RandomSkunkStructuredLoggingSkillSource)"
      DestinationFiles="$(_RandomSkunkStructuredLoggingSkillDestination)"
      SkipUnchangedFiles="true" />
  </Target>

  <!-- Cursor: drop-in rule file, auto-discovered (Auto Attached on **/*.cs), never touches other files. -->
  <PropertyGroup>
    <_RandomSkunkStructuredLoggingCursorRuleSource>$(MSBuildThisFileDirectory)../skillfiles/randomskunk-structuredlogging/cursor-rule.mdc</_RandomSkunkStructuredLoggingCursorRuleSource>
    <_RandomSkunkStructuredLoggingCursorRuleDestination>$(MSBuildProjectDirectory)/.cursor/rules/randomskunk-structuredlogging.mdc</_RandomSkunkStructuredLoggingCursorRuleDestination>
  </PropertyGroup>

  <Target Name="InstallRandomSkunkStructuredLoggingCursorRule"
          BeforeTargets="Build"
          AfterTargets="Restore"
          Condition="'$(RandomSkunkStructuredLoggingSkipCursorRulesInstall)' != 'true' and Exists('$(_RandomSkunkStructuredLoggingCursorRuleSource)')">
    <Copy
      SourceFiles="$(_RandomSkunkStructuredLoggingCursorRuleSource)"
      DestinationFiles="$(_RandomSkunkStructuredLoggingCursorRuleDestination)"
      SkipUnchangedFiles="true" />
  </Target>

  <!-- GitHub Copilot: drop-in path-specific instructions file, auto-discovered (applyTo **/*.cs), never touches other files. -->
  <PropertyGroup>
    <_RandomSkunkStructuredLoggingCopilotInstructionsSource>$(MSBuildThisFileDirectory)../skillfiles/randomskunk-structuredlogging/copilot-instructions.md</_RandomSkunkStructuredLoggingCopilotInstructionsSource>
    <_RandomSkunkStructuredLoggingCopilotInstructionsDestination>$(MSBuildProjectDirectory)/.github/instructions/randomskunk-structuredlogging.instructions.md</_RandomSkunkStructuredLoggingCopilotInstructionsDestination>
  </PropertyGroup>

  <Target Name="InstallRandomSkunkStructuredLoggingCopilotInstructions"
          BeforeTargets="Build"
          AfterTargets="Restore"
          Condition="'$(RandomSkunkStructuredLoggingSkipCopilotInstructionsInstall)' != 'true' and Exists('$(_RandomSkunkStructuredLoggingCopilotInstructionsSource)')">
    <Copy
      SourceFiles="$(_RandomSkunkStructuredLoggingCopilotInstructionsSource)"
      DestinationFiles="$(_RandomSkunkStructuredLoggingCopilotInstructionsDestination)"
      SkipUnchangedFiles="true" />
  </Target>

  <!--
    Codex (and any other tool following the AGENTS.md convention): unlike the three installs
    above, AGENTS.md is a single shared file the consuming project otherwise fully owns, so this
    can't be a plain file copy. Instead it merges an idempotent, delimited block into AGENTS.md:
    creates the file if it doesn't exist, replaces just the marked block on repeat builds (e.g.
    after a package upgrade changes the guidance text), or appends the block if the file exists
    but has never seen it before. Content outside the markers is never touched.
  -->
  <UsingTask
      TaskName="MergeRandomSkunkStructuredLoggingAgentsMd"
      TaskFactory="RoslynCodeTaskFactory"
      AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <BlockSource ParameterType="System.String" Required="true" />
      <DestinationFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs">
<![CDATA[
const string beginMarker = "<!-- BEGIN randomskunk-structuredlogging -->";
const string endMarker = "<!-- END randomskunk-structuredlogging -->";

var block = File.ReadAllText(BlockSource).TrimEnd('\r', '\n');
var wrapped = beginMarker + "\n" + block + "\n" + endMarker;

var destinationDirectory = Path.GetDirectoryName(DestinationFile);
if (!string.IsNullOrEmpty(destinationDirectory))
    Directory.CreateDirectory(destinationDirectory);

if (!File.Exists(DestinationFile))
{
    File.WriteAllText(DestinationFile, wrapped + "\n");
}
else
{
    var existing = File.ReadAllText(DestinationFile);
    var pattern = Regex.Escape(beginMarker) + "[\\s\\S]*?" + Regex.Escape(endMarker);

    if (Regex.IsMatch(existing, pattern))
    {
        var replacement = wrapped.Replace("$", "$$");
        var updated = Regex.Replace(existing, pattern, replacement);
        if (updated != existing)
            File.WriteAllText(DestinationFile, updated);
    }
    else
    {
        var separator = existing.EndsWith("\n") ? "\n" : "\n\n";
        File.WriteAllText(DestinationFile, existing + separator + wrapped + "\n");
    }
}
]]>
      </Code>
    </Task>
  </UsingTask>

  <PropertyGroup>
    <_RandomSkunkStructuredLoggingAgentsMdBlockSource>$(MSBuildThisFileDirectory)../skillfiles/randomskunk-structuredlogging/AGENTS.md.block</_RandomSkunkStructuredLoggingAgentsMdBlockSource>
    <_RandomSkunkStructuredLoggingAgentsMdDestination>$(MSBuildProjectDirectory)/AGENTS.md</_RandomSkunkStructuredLoggingAgentsMdDestination>
  </PropertyGroup>

  <Target Name="InstallRandomSkunkStructuredLoggingAgentsMd"
          BeforeTargets="Build"
          AfterTargets="Restore"
          Condition="'$(RandomSkunkStructuredLoggingSkipAgentsMdInstall)' != 'true' and Exists('$(_RandomSkunkStructuredLoggingAgentsMdBlockSource)')">
    <MergeRandomSkunkStructuredLoggingAgentsMd
      BlockSource="$(_RandomSkunkStructuredLoggingAgentsMdBlockSource)"
      DestinationFile="$(_RandomSkunkStructuredLoggingAgentsMdDestination)" />
  </Target>

</Project>
