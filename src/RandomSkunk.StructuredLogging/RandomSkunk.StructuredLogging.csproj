<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    Marks the assembly trim-safe and turns on the trim/AOT/single-file analyzers, so that any
    reflection this library performs either carries a [RequiresUnreferencedCode]/[RequiresDynamicCode]
    annotation (surfacing as a build warning in a consumer's trimmed or Native AOT app) or an
    [UnconditionalSuppressMessage] documenting why trimming it is safe. Without this, a consumer
    publishing trimmed or AOT gets no warning at all - see LogPropertyDestructuring.cs and
    Operation/ValueFormatting.cs, the library's only two reflection sites.
  -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>RandomSkunk.StructuredLogging</PackageId>
    <Authors>Brian Friesen</Authors>
    <Description>Modern structured logging extensions for .NET that separate human-readable messages from machine-readable attributes. Include contextual data (user IDs, correlation IDs, metrics) in logs without forcing them into message templates.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>logging;structured-logging;dotnet</PackageTags>
    <Copyright>Copyright (c) 2025-2026 Brian Friesen</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <!--
    MSB3277 is expected and benign: it's netstandard2.0-vs-net8.0/net10.0 System.Collections.Immutable
    unification noise from referencing the analyzer project's own (unused-here) Roslyn dependency
    closure, not a real conflict in this library's compiled output. It also surfaces in any other
    in-repo project that references this one (see RandomSkunk.StructuredLogging.Tests.csproj),
    since the reference is real; it does not surface for actual package consumers, since the
    published Analyzers package has no lib/ref assembly to conflict with in the first place.
  -->
  <PropertyGroup>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <!--
    Referenced as a real (non-ReferenceOutputAssembly=false) project reference purely so that
    packing this project declares a corresponding <dependency> on
    RandomSkunk.StructuredLogging.Analyzers in this package's nuspec, auto-versioned to whatever
    version that project currently has — so installing this package also installs the analyzer.
    This does NOT run the analyzer against this project's own code (no OutputItemType=Analyzer).

    PrivateAssets=none keeps the "analyzers" asset from being marked private, so the dependency
    stays active for whoever installs this package (the SDK's default PrivateAssets for any
    reference excludes "build" and "analyzers" from flowing to consumers, which would otherwise
    silently defeat the whole point of this dependency).

    Private=false stops the analyzer assembly (a build-time-only tool, irrelevant to this
    library's own compiled output) from being copied to this project's own output directory. Note
    this only covers this project's own output; any other in-repo project that references this
    one (e.g. RandomSkunk.StructuredLogging.Tests) will still get the analyzer dll copied to its
    own (unpacked, gitignored) output directory as a transitive side effect - harmless, but not
    worth fighting further given it never ships anywhere.
  -->
  <ItemGroup>
    <ProjectReference Include="../RandomSkunk.StructuredLogging.Analyzers/RandomSkunk.StructuredLogging.Analyzers.csproj" Private="false" PrivateAssets="none" />
  </ItemGroup>

</Project>
